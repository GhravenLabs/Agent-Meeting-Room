# Optional cloud agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# GOOGLE_API_KEY= also works for @gemini / @google.
GEMINI_MODEL=gemini-2.5-flash

# Memory backend: auto, local, obsidian, or none.
MEMORY_BACKEND=local

# Only needed when MEMORY_BACKEND=obsidian.
OBSIDIAN_VAULT_PATH=

# Optional local memory folder override.
LOCAL_MEMORY_PATH=

# Optional app server port.
PORT=5000
