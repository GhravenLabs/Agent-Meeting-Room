# Agent Meeting Room — environment config
# Copy this file to .env and fill in your values
# Never commit .env to git

# ─────────────────────────────────────────────
# Claude API (optional — only needed for @claude)
# Get your key at https://console.anthropic.com
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ─────────────────────────────────────────────
# Memory backend
# Options:
#   auto     — uses Obsidian if OBSIDIAN_VAULT_PATH is set, otherwise local folder
#   local    — saves notes to ./meeting_notes/ next to app.py (no extra software needed)
#   obsidian — saves notes to your Obsidian vault (requires Obsidian installed)
#   none     — memory disabled entirely
# ─────────────────────────────────────────────
MEMORY_BACKEND=local


# ─────────────────────────────────────────────
# Obsidian vault path (only needed if MEMORY_BACKEND=obsidian)
# Set this to the folder inside your vault where you want notes saved
# ─────────────────────────────────────────────
# Windows example:
# OBSIDIAN_VAULT_PATH=C:/Users/YourName/Documents/ObsidianVault/AgentMeetings
# Mac/Linux example:
# OBSIDIAN_VAULT_PATH=/home/yourname/ObsidianVault/AgentMeetings


# ─────────────────────────────────────────────
# Local memory folder (only used if MEMORY_BACKEND=local)
# Defaults to ./meeting_notes/ next to app.py — change if you want a different location
# ─────────────────────────────────────────────
# LOCAL_MEMORY_PATH=./meeting_notes


# ─────────────────────────────────────────────
# Free Talk duration in seconds (default: 300 = 5 minutes)
# ─────────────────────────────────────────────
# FREE_TALK_DURATION=300


# ─────────────────────────────────────────────
# Server port (default: 5000)
# ─────────────────────────────────────────────
# PORT=5000
